---
// Súbor: src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import AtelierSection from '../components/AtelierSection.astro';
import CreationsSection from '../components/CreationsSection.astro';
import WeddingsSection from '../components/WeddingsSection.astro';
import QuoteSection from '../components/QuoteSection.astro';
import OnlineSection from '../components/OnlineSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import ScrollTopBtn from '../components/ScrollTopBtn.astro';
import GalleryModal from '../components/GalleryModal.astro';

const pageTitle = "Kytica od srdca | Kvetinový ateliér v Trenčianskej Teplej";
const pageDescription = "Kvetinový ateliér v Trenčianskej Teplej: autorské kytice a boxy na mieru, svadobná floristika, smútočné vence, orchidey a darčeky. Objednávky telefonicky alebo osobne v ateliéri.";
---
<Layout title={pageTitle} description={pageDescription}>
    <Header />

    <main id="obsah">
        <HeroSection />
        <AtelierSection />
        <CreationsSection />
        <WeddingsSection />
        <QuoteSection />
        <OnlineSection />
        <ContactSection />
    </main>

    <Footer />
    <ScrollTopBtn />
    <GalleryModal />
</Layout>
