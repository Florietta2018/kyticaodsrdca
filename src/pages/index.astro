---
// Súbor: src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import AtelierSection from '../components/AtelierSection.astro';
import CreationsSection from '../components/CreationsSection.astro';
import QuoteSection from '../components/QuoteSection.astro';
import OnlineSection from '../components/OnlineSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import ScrollTopBtn from '../components/ScrollTopBtn.astro';
import GalleryModal from '../components/GalleryModal.astro';

// Titulok do ~60 znakov a popis do ~155 znakov, aby ich Google nezrezal.
const pageTitle = "Kytica od srdca | Kvetinárstvo v Trenčianskej Teplej";
const pageDescription = "Kvetinárstvo v Trenčianskej Teplej: kytice a boxy na mieru, svadobná floristika, smútočné vence, izbové rastliny a darčeky. Vyberte si aj v online ponuke.";
---
<Layout title={pageTitle} description={pageDescription}>
    <Header />

    <main id="obsah">
        <HeroSection />
        <AtelierSection />
        <CreationsSection />
        <QuoteSection />
        <OnlineSection />
        <ContactSection />
    </main>

    <Footer />
    <ScrollTopBtn />
    <GalleryModal />
</Layout>
