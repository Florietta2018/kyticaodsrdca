---
// Súbor: src/components/Header.astro
import Icon from './Icon.astro';
import { CONTACT, HOURS } from '../data/site';
---
<header class="header" id="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="Kytica od srdca, úvodná stránka">
      <span class="brand-mark">
        <img class="brand-logo brand-logo--light" src="/img/LOGO_KRUH-pinkwhite.svg" alt="" width="48" height="48">
        <img class="brand-logo brand-logo--dark" src="/img/logo-darkpink.svg" alt="" width="48" height="48">
      </span>
      <span class="brand-name">Kytica od srdca</span>
    </a>

    <nav class="nav" id="site-nav" aria-label="Hlavná navigácia">
      <a href="/#creations" class="nav-link">Naša tvorba</a>
      <a href="/#atelier" class="nav-link">Ateliér</a>
      <a href="/#contact" class="nav-link">Kontakt</a>
      <a href={CONTACT.online} target="_blank" rel="noopener noreferrer" class="nav-cta">Objednať kyticu</a>
      <a href={CONTACT.facebook} target="_blank" rel="noopener noreferrer" class="nav-social" aria-label="Facebook">
        <Icon name="facebook" size={18} />
      </a>

      <!-- Spodok mobilného menu: rýchly kontakt (na počítači skrytý) -->
      <div class="nav-panel">
        <p class="nav-status open-status" data-open-status data-hours={JSON.stringify(HOURS)} hidden></p>
        <ul class="nav-contacts">
          <li><a href={`tel:${CONTACT.phone}`}><Icon name="phone" size={18} />{CONTACT.phoneLabel}</a></li>
          <li><a href={CONTACT.maps} target="_blank" rel="noopener noreferrer"><Icon name="pin" size={18} />M. R. Štefánika 360, Trenčianska Teplá</a></li>
          <li><a href={CONTACT.facebook} target="_blank" rel="noopener noreferrer"><Icon name="facebook" size={18} />Facebook</a></li>
        </ul>
      </div>
    </nav>

    <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-toggle-label">Menu</span>
      <span class="menu-toggle-lines" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
</header>
