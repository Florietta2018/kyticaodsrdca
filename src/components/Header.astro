---
// Súbor: src/components/Header.astro
import { Image } from 'astro:assets';
import logoLight from '../assets/img/LOGO_KRUH-pinkwhite.png';
import logoDark from '../assets/img/Logo darkping.png';
import Icon from './Icon.astro';
import { CONTACT, HOURS } from '../data/site';

interface Props {
  solid?: boolean;
}
const { solid = false } = Astro.props;
---
<header class={`header${solid ? ' is-scrolled is-static-solid' : ''}`} id="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="Kytica od srdca, úvodná stránka">
      <span class="brand-mark" aria-hidden="true">
        <Image
          class="brand-logo brand-logo--light"
          src={logoLight}
          alt=""
          widths={[108, 216]}
          sizes="54px"
          quality={92}
          loading="eager"
          decoding="async"
        />
        <Image
          class="brand-logo brand-logo--dark"
          src={logoDark}
          alt=""
          widths={[108, 216]}
          sizes="54px"
          quality={92}
          loading="eager"
          decoding="async"
        />
      </span>
      <span class="brand-wordmark">
        <span class="brand-name">Kytica <em>od</em> srdca</span>
        <span class="brand-sub">Kvetinový ateliér</span>
      </span>
    </a>

    <nav class="nav" id="site-nav" aria-label="Hlavná navigácia">
      <a href="/#atelier" class="nav-link">Ateliér</a>
      <a href="/#creations" class="nav-link">Naša tvorba</a>
      <a href="/#weddings" class="nav-link">Svadby</a>
      <a href="/#contact" class="nav-link">Kontakt</a>
      <a href={`tel:${CONTACT.phone}`} class="nav-cta">
        <Icon name="phone" size={15} />
        <span>Objednať · {CONTACT.phoneLabel}</span>
      </a>
      <a href={CONTACT.facebook} target="_blank" rel="noopener noreferrer" class="nav-social" aria-label="Facebook">
        <Icon name="facebook" size={17} />
      </a>

      <!-- Spodok mobilného menu: živý stav prevádzky a rýchly kontakt -->
      <div class="nav-panel">
        <p class="nav-status open-status" data-open-status data-hours={JSON.stringify(HOURS)} hidden></p>
        <ul class="nav-contacts">
          <li><a href={`tel:${CONTACT.phone}`}><Icon name="phone" size={18} />{CONTACT.phoneLabel}</a></li>
          <li><a href={CONTACT.maps} target="_blank" rel="noopener noreferrer"><Icon name="pin" size={18} />{CONTACT.streetShort}, {CONTACT.locality}</a></li>
          <li><a href={CONTACT.facebook} target="_blank" rel="noopener noreferrer"><Icon name="facebook" size={18} />Facebook</a></li>
        </ul>
      </div>
    </nav>

    <button
      class="menu-toggle"
      id="menu-toggle"
      type="button"
      aria-label="Otvoriť menu"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="menu-toggle-label">Menu</span>
      <span class="menu-toggle-lines" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
</header>
