---
// Súbor: src/components/OnlineSection.astro
import { Image } from 'astro:assets';
import imgMain from '../assets/img/n14.jpeg';
import imgSecond from '../assets/img/n13.jpeg';
import { CONTACT, nb } from '../data/site';

// Postup objednávky: skutočná postupnosť krokov, preto číslovaný zoznam.
const steps = [
  { title: 'Vyberte si online alebo zavolajte', text: `Pozrite si online ponuku, alebo nám zavolajte na ${CONTACT.phoneLabel} a povedzte, čo si predstavujete.` },
  { title: 'Kyticu uviažeme', text: 'Pripravíme ju ručne z čerstvých sezónnych kvetov podľa vášho výberu.' },
  { title: 'Vyzdvihnete si ju bez čakania', text: 'Hotová vás čaká u nás v obchode na Štefánikovej ulici v Trenčianskej Teplej.' },
];
---
<section class="online" id="online">
  <div class="online-inner">
    <div class="online-photos">
      <Image src={imgMain} alt="Ružová kytica s eukalyptom zabalená v ružovom papieri" class="online-photo-main" widths={[400, 700]} sizes="(max-width: 900px) 75vw, 34vw" loading="lazy" />
      <!-- Menšia fotka sa pri skrolovaní posúva rýchlejšie, kompozícia tak dostane hĺbku -->
      <Image src={imgSecond} alt="Pestrá lúčna kytica v pastelovom papieri" class="online-photo-second" widths={[300, 500]} sizes="(max-width: 900px) 42vw, 19vw" loading="lazy" data-parallax="-0.09" data-parallax-layer />
    </div>
    <div class="online-text">
      <h2 class="section-title"><span class="reveal-inner">Kytica pripravená, kým prídete</span></h2>
      <p>{nb('Kyticu alebo darček si vyberiete z pohodlia domova a u nás si ich už len vyzdvihnete.')}</p>

      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step">
            <span class="step-num" aria-hidden="true">{i + 1}</span>
            <div>
              <h3>{nb(s.title)}</h3>
              <p>{nb(s.text)}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="online-actions">
        <a href={CONTACT.online} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Prejsť do online ponuky</a>
        <a href={`tel:${CONTACT.phone}`} class="btn btn-outline">Zavolať {CONTACT.phoneLabel}</a>
      </div>
    </div>
  </div>
</section>
