---
// Súbor: src/components/AtelierSection.astro
import { Image } from 'astro:assets';
import imgSpolocna from '../assets/img/spolocna.webp';
import { nb } from '../data/site';

const services = [
  { title: 'Kytice a boxy', text: 'Na narodeniny, výročie aj len tak, viazané na mieru.' },
  { title: 'Svadby', text: 'Kytica pre nevestu aj výzdoba obradu a hostiny.' },
  { title: 'Smútočná väzba', text: 'Vence a smútočné kytice s citom a úctou.' },
  { title: 'Rastliny a darčeky', text: 'Orchidey, zeleň, keramika a drobnosti pre radosť.' },
];
---
<section class="atelier" id="atelier">
  <div class="atelier-inner">
    <figure class="atelier-photo">
      <div class="atelier-media">
        <!-- Oblúkový rám: fotka sa pri skrolovaní v ráme jemne posúva (paralax) -->
        <span class="atelier-frame" data-parallax="0.08">
          <Image src={imgSpolocna} alt="Beatrica a Silvia, majiteľky kvetinárstva Kytica od srdca, s pudlíkom Starkom v ateliéri" widths={[400, 600]} sizes="(max-width: 900px) 80vw, 420px" loading="lazy" />
        </span>
        <span class="atelier-outline" aria-hidden="true"></span>
      </div>
      <figcaption class="atelier-caption">{nb('Beatrica a Silvia, majiteľky ateliéru, a pudlík Stark')}</figcaption>
    </figure>

    <div class="atelier-text">
      <h2 class="section-title"><span class="reveal-inner">{nb('Viazané s láskou a dušou')}</span></h2>
      <p class="lead">{nb('Každá kytica, ktorú vytvoríme, nesie viac než kvety: pozornosť, čas a rešpekt k prírode.')}</p>
      <p>{nb('V našom ateliéri v Trenčianskej Teplej nájdete čerstvé sezónne a lokálne kvety z overených zdrojov, ručne vyrábanú keramiku a štýlové dekorácie. Radi poradíme s výberom alebo uviažeme kyticu presne podľa vašich predstáv.')}</p>

      <dl class="services">
        {services.map((s) => (
          <div class="service">
            <dt>{nb(s.title)}</dt>
            <dd>{nb(s.text)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
