---
// Súbor: src/components/CreationsSection.astro
import { Image, getImage } from 'astro:assets';
import { nb } from '../data/site';
import k1 from '../assets/img/k1.jpg';
import k2 from '../assets/img/k2.jpg';
import k3 from '../assets/img/k3.jpg';
import k5 from '../assets/img/k5.jpg';
import k6 from '../assets/img/k6.jpg';
import k7 from '../assets/img/k7.jpg';
import k8 from '../assets/img/k8.jpg';
import k9 from '../assets/img/k9.jpg';
import n1 from '../assets/img/n1.jpeg';
import n2 from '../assets/img/n2.jpeg';
import n3 from '../assets/img/n3.jpeg';
import n4 from '../assets/img/n4.jpeg';
import n5 from '../assets/img/n5.jpeg';
import n6 from '../assets/img/n6.jpeg';
import n7 from '../assets/img/n7.jpeg';
import n8 from '../assets/img/n8.jpeg';
import n9 from '../assets/img/n9.jpeg';
import n10 from '../assets/img/n10.jpeg';
import n11 from '../assets/img/n11.jpeg';
import n12 from '../assets/img/n12.jpeg';

// batch 0 je viditeľný hneď, ďalšie sa na počítači odkrývajú tlačidlom.
const items = [
  { src: k1, caption: 'Biela kytica s eukalyptom', batch: 0 },
  { src: k2, caption: 'Kvetinový box', batch: 0 },
  { src: k3, caption: 'Aranžmán v kvetináči', batch: 0 },
  { src: k8, caption: 'Čistá elegancia', batch: 0 },
  { src: k5, caption: 'Prírodná krása', batch: 0 },
  { src: k6, caption: 'Kvetinová radosť', batch: 0 },
  { src: k7, caption: 'Farebná harmónia', batch: 0 },
  { src: k9, caption: 'Voňavý pozdrav', batch: 0 },
  { src: n1, caption: 'Kytica na mieru', batch: 1 },
  { src: n2, caption: 'Pastelový kvetinový box', batch: 1 },
  { src: n3, caption: 'Svadobná kytica', batch: 1 },
  { src: n4, caption: 'Milé potešenie', batch: 1 },
  { src: n5, caption: 'Pestré farby', batch: 2 },
  { src: n6, caption: 'Nežný dotyk', batch: 2 },
  { src: n7, caption: 'Elegantná krása', batch: 2 },
  { src: n8, caption: 'Jemná harmónia', batch: 2 },
  { src: n9, caption: 'Sezónny výber', batch: 3 },
  { src: n10, caption: 'Lokálne kvety', batch: 3 },
  { src: n11, caption: 'Moderný aranžmán', batch: 3 },
  { src: n12, caption: 'Kvety vo vedierku', batch: 3 },
];

// Väčšia verzia každej fotky pre lightbox.
const gallery = await Promise.all(
  items.map(async (item) => ({
    ...item,
    full: (await getImage({ src: item.src, width: 1400, format: 'webp' })).src,
  }))
);
const maxBatch = Math.max(...items.map((i) => i.batch));
---
<section class="creations" id="creations">
  <div class="creations-head">
    <h2 class="section-title" data-reveal="mask"><span class="reveal-inner">Z našej dielne</span></h2>
    <p data-reveal="up" data-reveal-delay="150">{nb('Kytice a aranžmány, ktoré u nás vznikli. Žiadna sa neopakuje, každú viažeme pre konkrétneho človeka a chvíľu.')}</p>
  </div>

  <div class="gallery" id="gallery" data-max-batch={maxBatch}>
    {gallery.map((item, i) => (
      <button
        type="button"
        class={`gallery-item${item.batch > 0 ? ' is-extra' : ''}`}
        data-batch={item.batch}
        data-full={item.full}
        data-caption={item.caption}
        data-index={i}
        data-reveal={item.batch === 0 ? 'image' : undefined}
        data-reveal-delay={item.batch === 0 ? String((i % 4) * 70) : undefined}
        aria-label={`Zväčšiť fotografiu: ${item.caption}`}
      >
        <span class="gallery-photo">
          <Image src={item.src} alt={item.caption} widths={[360, 560, 800]} sizes="(max-width: 767px) 78vw, (max-width: 1200px) 33vw, 25vw" loading="lazy" />
        </span>
        <span class="gallery-caption" aria-hidden="true">{item.caption}</span>
      </button>
    ))}
  </div>

  <div class="gallery-progress" aria-hidden="true">
    <div class="gallery-progress-track"><div class="gallery-progress-thumb" id="gallery-thumb"></div></div>
    <span class="gallery-progress-hint">Potiahnite pre ďalšie fotky</span>
  </div>

  <div class="gallery-more">
    <button type="button" class="btn btn-outline" id="gallery-more">Zobraziť ďalšie fotky</button>
    <button type="button" class="btn-text" id="gallery-less" hidden>Zobraziť menej</button>
  </div>
</section>
