---
// Súbor: src/components/CreationsSection.astro
import { Image, getImage } from 'astro:assets';
import { nb } from '../data/site';
import k1 from '../assets/img/k1.jpg';
import k2 from '../assets/img/k2.jpg';
import k3 from '../assets/img/k3.jpg';
import k4 from '../assets/img/k4.jpg';
import k5 from '../assets/img/k5.jpg';
import k7 from '../assets/img/k7.jpg';
import k8 from '../assets/img/k8.jpg';
import k9 from '../assets/img/k9.jpg';
import n1 from '../assets/img/n1.jpeg';
import n2 from '../assets/img/n2.jpeg';
import n3 from '../assets/img/n3.jpeg';
import n5 from '../assets/img/n5.jpeg';
import n7 from '../assets/img/n7.jpeg';
import n9 from '../assets/img/n9.jpeg';
import n11 from '../assets/img/n11.jpeg';
import n12 from '../assets/img/n12.jpeg';

const categories = [
  { id: 'all', label: 'Celý výber' },
  { id: 'kytice', label: 'Kytice' },
  { id: 'boxy', label: 'Kvetinové boxy' },
  { id: 'svadby', label: 'Svadby' },
  { id: 'dekoracie', label: 'Aranžmány a vence' },
];

// Kurátorský výber 16 unikátnych prác bez duplicít a s čistými orezmi.
const items = [
  { src: k1, caption: 'Biela eustoma s eukalyptom', category: 'svadby', tag: 'Svadobná väzba', batch: 0 },
  { src: n9, caption: 'Ružová symfónia s eukalyptom', category: 'kytice', tag: 'Podpisová kytica', batch: 0 },
  { src: n11, caption: 'Púdrové tóny v zamatovom boxe', category: 'boxy', tag: 'Kvetinový box', batch: 0 },
  { src: k8, caption: 'Smaragd a pávie pierko', category: 'dekoracie', tag: 'Interiérový aranžmán', batch: 0 },
  { src: n3, caption: 'Nevesta v čipke a zeleni', category: 'svadby', tag: 'Svadobná kytica', batch: 0 },
  { src: k2, caption: 'Ranná rosa v akvarelovom boxe', category: 'boxy', tag: 'Kvetinový box', batch: 0 },
  { src: k3, caption: 'Jesenná poézia v prútí', category: 'dekoracie', tag: 'Trvácny aranžmán', batch: 0 },
  { src: n1, caption: 'Kytičky v prírodnom papieri', category: 'kytice', tag: 'Darčeková väzba', batch: 0 },
  { src: k4, caption: 'Svadobná kytica s pierkom', category: 'svadby', tag: 'Svadobný set', batch: 1 },
  { src: k5, caption: 'Obláčik z pastelovej gypsomilky', category: 'boxy', tag: 'Kvetinový box', batch: 1 },
  { src: k7, caption: 'Čistota bielych ruží', category: 'dekoracie', tag: 'Aranžmán v nádobe', batch: 1 },
  { src: n2, caption: 'Lúčna harmónia v ružovom', category: 'boxy', tag: 'Kvetinový box', batch: 1 },
  { src: n7, caption: 'Romantická eustoma a zeleň', category: 'boxy', tag: 'Kvetinový box', batch: 2 },
  { src: k9, caption: 'Ruže na kováčskej bráne', category: 'dekoracie', tag: 'Veniec na dvere', batch: 2 },
  { src: n12, caption: 'Záhradný pozdrav s nevädzou', category: 'dekoracie', tag: 'Aranžmán vo vedierku', batch: 2 },
  { src: n5, caption: 'Purpurové pohladenie', category: 'boxy', tag: 'Kvetinový box', batch: 2 },
];

const gallery = await Promise.all(
  items.map(async (item) => ({
    ...item,
    full: (await getImage({ src: item.src, width: 1400, format: 'webp' })).src,
  }))
);
const maxBatch = Math.max(...items.map((i) => i.batch));
---
<section class="creations" id="creations">
  <div class="creations-head">
    <div>
      <p class="section-kicker">Z našej dielne</p>
      <h2 class="section-title">Kurátorský výber <em>tvorby</em></h2>
    </div>
    <p class="creations-intro">{nb('Kytice, boxy a aranžmány, ktoré vznikli pod našimi rukami. Žiadna väzba sa neopakuje — každú tvoríme pre konkrétneho človeka a okamih.')}</p>
  </div>

  <div class="gallery-filters" role="tablist" aria-label="Filtrovať tvorbu podľa príležitosti">
    {categories.map((cat, idx) => (
      <button
        type="button"
        role="tab"
        class={`filter-btn${idx === 0 ? ' is-active' : ''}`}
        data-filter={cat.id}
        aria-selected={idx === 0 ? 'true' : 'false'}
      >
        {cat.label}
      </button>
    ))}
  </div>

  <div class="gallery" id="gallery" data-max-batch={maxBatch}>
    {gallery.map((item, i) => (
      <button
        type="button"
        class={`gallery-item${item.batch > 0 ? ' is-extra' : ''}`}
        data-batch={item.batch}
        data-category={item.category}
        data-full={item.full}
        data-caption={item.caption}
        data-tag={item.tag}
        data-index={i}
        data-reveal={item.batch === 0 ? 'image' : undefined}
        aria-label={`Zväčšiť fotografiu: ${item.caption} (${item.tag})`}
      >
        <span class="gallery-photo">
          <Image
            src={item.src}
            alt={item.caption}
            widths={[360, 560, 800]}
            sizes="(max-width: 767px) 78vw, (max-width: 1023px) 46vw, 24vw"
            loading="lazy"
          />
          <span class="gallery-zoom-pill" aria-hidden="true">Detail</span>
        </span>
        <span class="gallery-meta" aria-hidden="true">{item.tag}</span>
        <span class="gallery-caption" aria-hidden="true">{item.caption}</span>
      </button>
    ))}
  </div>

  <div class="gallery-progress" aria-hidden="true">
    <div class="gallery-progress-track"><div class="gallery-progress-thumb" id="gallery-thumb"></div></div>
    <span class="gallery-progress-hint">Potiahnite pre ďalšie fotky</span>
  </div>

  <div class="gallery-more" id="gallery-more-wrap">
    <button type="button" class="btn btn-outline" id="gallery-more">Zobraziť ďalšie práce</button>
    <button type="button" class="btn-text" id="gallery-less" hidden>Zobraziť menej</button>
  </div>
</section>
