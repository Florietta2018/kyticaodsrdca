---
// Súbor: src/components/QuoteSection.astro
// Fotka ateliéru cez celú šírku: desktop aj mobil používajú celoročné zábery orchideí (bez vianočných dekorácií a dátumoviek).
import { Image } from 'astro:assets';
import imgShopWide from '../assets/img/obchodtit.webp';
import imgShopOrchids from '../assets/img/obchod-orchidey.webp';
import { nb } from '../data/site';
---
<section class="quote" aria-label="Filozofia ateliéru" data-parallax="0.06">
  <Image
    src={imgShopWide}
    alt="Interiér kvetinárstva Kytica od srdca s orchideami, izbovými rastlinami a darčekmi"
    class="quote-img quote-img--wide"
    widths={[800, 1280, 1920]}
    sizes="100vw"
    loading="lazy"
  />
  <Image
    src={imgShopOrchids}
    alt="Rozkvitnuté ružové a biele orchidey v tehlovom interiéri nášho ateliéru"
    class="quote-img quote-img--tall"
    widths={[480, 785]}
    sizes="100vw"
    loading="lazy"
  />
  <div class="quote-shade" aria-hidden="true"></div>
  <figure class="quote-content">
    <span class="quote-ornament" aria-hidden="true"></span>
    <blockquote class="quote-text">
      <p>
        <span class="quote-line">{nb('„Nie je to len krása.')}</span>
        <span class="quote-line">Je to cit.“</span>
      </p>
    </blockquote>
    <figcaption class="quote-author">Ateliér Kytica od srdca</figcaption>
  </figure>
</section>
