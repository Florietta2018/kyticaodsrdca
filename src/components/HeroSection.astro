---
// Súbor: src/components/HeroSection.astro
// Záložné fotky pod videom: zobrazia sa, kým sa video z Bunny CDN nenačíta alebo ak sa
// nenačíta vôbec (CDN ho púšťa len na doméne kyticaodsrdca.sk, lokálne vždy uvidíte fotku).
import heroPosterDesktop from '../assets/img/obchodtit.webp';
import heroPosterMobile from '../assets/img/obchodtit.webp';
import { CONTACT, HOURS } from '../data/site';
---
<section class="hero" id="home">
    <div class="hero-media" aria-hidden="true">
        <video class="hero-video hero-desktop" autoplay loop muted playsinline disablePictureInPicture poster="https://kytica.b-cdn.net/Kyticadesktop.webp" style={`background-image: url('${heroPosterDesktop.src}');`}>
            <source src="https://kytica.b-cdn.net/Kyticadesktop.mp4" type="video/mp4" />
        </video>
        <video class="hero-video hero-mobile" autoplay loop muted playsinline disablePictureInPicture poster="https://kytica.b-cdn.net/Kyticamob.webp" style={`background-image: url('${heroPosterMobile.src}');`}>
            <source src="https://kytica.b-cdn.net/Kyticamob.mp4" type="video/mp4" />
        </video>
    </div>
    <div class="hero-shade" aria-hidden="true"></div>

    <div class="hero-inner">
        <p class="hero-place">Kvetinárstvo v Trenčianskej Teplej</p>
        <h1 class="hero-title">
            <span class="hero-line"><span class="hero-line-inner">Prekvapte krásou,</span></span>
            <span class="hero-line"><span class="hero-line-inner">dotknite sa srdca</span></span>
        </h1>
        <p class="hero-sub">Čerstvé, sezónne kvety viazané ručne v&nbsp;našom ateliéri.</p>
        <div class="hero-actions">
            <a href={CONTACT.online} target="_blank" rel="noopener noreferrer" class="btn btn-on-dark" id="fcHeroBtn">Pozrieť online ponuku</a>
            <a href={`tel:${CONTACT.phone}`} class="btn btn-ghost-on-dark">Zavolať {CONTACT.phoneLabel}</a>
        </div>
    </div>

    <p class="hero-status open-status" data-open-status data-hours={JSON.stringify(HOURS)} hidden></p>
</section>
