---
// Súbor: src/components/ContactSection.astro
import Icon from './Icon.astro';
import { CONTACT, HOURS, formatTime, nb } from '../data/site';
---
<section class="visit" id="contact">
  <div class="visit-inner">
    <div class="visit-text">
      <h2 class="section-title" data-reveal="mask"><span class="reveal-inner">Zastavte sa u nás</span></h2>
      <p class="visit-intro">{nb('Radi vás privítame v ateliéri, poradíme s výberom alebo pripravíme kyticu presne podľa vašich predstáv.')}</p>

      <div class="visit-columns">
        <div class="visit-block">
          <h3>Adresa</h3>
          <address>{CONTACT.street}<br>{CONTACT.city}</address>
        </div>

        <div class="visit-block">
          <h3>Otváracie hodiny</h3>
          <table class="hours">
            <tbody>
              {HOURS.map((h) => (
                <tr data-days={h.days.join(',')}>
                  <th scope="row">{h.label}</th>
                  <td>{h.open && h.close ? `${formatTime(h.open)} – ${formatTime(h.close)}` : 'zatvorené'}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="visit-status open-status" data-open-status data-hours={JSON.stringify(HOURS)} hidden></p>
        </div>
      </div>

      <ul class="visit-contacts">
        <li><a href={`tel:${CONTACT.phone}`}><Icon name="phone" />{CONTACT.phoneLabel}</a></li>
        <li><a href={`mailto:${CONTACT.email}`}><Icon name="mail" />{CONTACT.email}</a></li>
        <li><a href={CONTACT.facebook} target="_blank" rel="noopener noreferrer"><Icon name="facebook" />Facebook</a></li>
      </ul>
    </div>

    <div class="visit-map">
      <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2621.0166389717374!2d18.115330376781355!3d48.9341248953734!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x471498ed83410c21%3A0x66485db2c9bd05e3!2sMilana%20Rastislava%20%C5%A0tef%C3%A1nika%20360%2C%20914%2001%20Tren%C4%8Dianska%20Tepl%C3%A1!5e0!3m2!1ssk!2ssk!4v1751097908537!5m2!1ssk!2ssk" title="Mapa: kvetinárstvo Kytica od srdca, Trenčianska Teplá" width="1200" height="380" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      <!-- Najčastejšie akcie pri mape: jedno ťuknutie otvorí navigáciu alebo hovor -->
      <div class="visit-map-actions">
        <a href={CONTACT.maps} target="_blank" rel="noopener noreferrer" class="btn btn-on-dark"><Icon name="pin" size={18} />Navigovať</a>
        <a href={`tel:${CONTACT.phone}`} class="btn btn-ghost-on-dark"><Icon name="phone" size={18} />Zavolať</a>
      </div>
    </div>
  </div>
</section>
