---
// Súbor: src/components/Footer.astro
import { CONTACT } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer" id="footer">
  <div class="footer-inner">
    <p class="footer-wordmark" aria-hidden="true" data-reveal="mask"><span class="reveal-inner">Kytica od srdca</span></p>

    <div class="footer-bottom">
      <nav class="footer-links" aria-label="Odkazy v pätičke">
        <a href={CONTACT.online} target="_blank" rel="noopener noreferrer">Online ponuka</a>
        <a href={CONTACT.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
        <a href={`tel:${CONTACT.phone}`}>{CONTACT.phoneLabel}</a>
      </nav>
      <p class="footer-copy">© {year} Kytica od srdca, Florietta s. r. o.</p>
    </div>
  </div>
</footer>
