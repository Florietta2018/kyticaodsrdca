---
// Súbor: src/components/Icon.astro
// Malá sada tenkých ikon, aby web nemusel načítavať celú knižnicu ikon.
interface Props {
  name: 'phone' | 'mail' | 'facebook' | 'pin' | 'arrow-up' | 'arrow-left' | 'arrow-right' | 'close';
  size?: number;
}
const { name, size = 20 } = Astro.props;
---
<svg class={`icon icon-${name}`} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'phone' && <path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11.5 11.5 0 0 0 7.2 7.2l1.4-2.1 4.2 1.6V19a1.5 1.5 0 0 1-1.6 1.5C10.6 20 4 13.4 3.5 5.1A1.5 1.5 0 0 1 5 3.5Z" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="m3.5 6 8.5 7 8.5-7" /></>}
  {name === 'facebook' && <path d="M14 8.5V6.8c0-.8.5-1.3 1.3-1.3H17V2.5h-2.4C11.9 2.5 10.5 4 10.5 6.6v1.9H8v3h2.5v10h3.5v-10h2.6l.4-3H14Z" />}
  {name === 'pin' && <><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.3" /></>}
  {name === 'arrow-up' && <path d="M12 19V5m0 0-6 6m6-6 6 6" />}
  {name === 'arrow-left' && <path d="M19 12H5m0 0 6-6m-6 6 6 6" />}
  {name === 'arrow-right' && <path d="M5 12h14m0 0-6-6m6 6-6 6" />}
  {name === 'close' && <path d="M5 5l14 14M19 5 5 19" />}
</svg>
