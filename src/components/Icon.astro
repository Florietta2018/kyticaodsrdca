---
// Súbor: src/components/Icon.astro
// Malá sada jemných vektorových ikon (1.3px ťah) pre čistý klenotnícky výraz bez externej knižnice.
interface Props {
  name:
    | 'phone'
    | 'mail'
    | 'facebook'
    | 'pin'
    | 'arrow-up'
    | 'arrow-left'
    | 'arrow-right'
    | 'arrow-up-right'
    | 'close'
    | 'botanical-heart'
    | 'leaf'
    | 'ribbon'
    | 'note';
  size?: number;
}
const { name, size = 20 } = Astro.props;
---
<svg
  class={`icon icon-${name}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'phone' && <path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11.5 11.5 0 0 0 7.2 7.2l1.4-2.1 4.2 1.6V19a1.5 1.5 0 0 1-1.6 1.5C10.6 20 4 13.4 3.5 5.1A1.5 1.5 0 0 1 5 3.5Z" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="1.2" /><path d="m3.5 6 8.5 7 8.5-7" /></>}
  {name === 'facebook' && <path d="M14 8.5V6.8c0-.8.5-1.3 1.3-1.3H17V2.5h-2.4C11.9 2.5 10.5 4 10.5 6.6v1.9H8v3h2.5v10h3.5v-10h2.6l.4-3H14Z" />}
  {name === 'pin' && <><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.2" /></>}
  {name === 'arrow-up' && <path d="M12 19V5m0 0-5.5 5.5M12 5l5.5 5.5" />}
  {name === 'arrow-left' && <path d="M19 12H5m0 0 5.5-5.5M5 12l5.5 5.5" />}
  {name === 'arrow-right' && <path d="M5 12h14m0 0-5.5-5.5M19 12l-5.5 5.5" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M9 7h8v8" />}
  {name === 'close' && <path d="M5.5 5.5l13 13M18.5 5.5l-13 13" />}
  {name === 'botanical-heart' && (
    <>
      <path d="M12 20.2s-7-4.4-7-9.8a4.1 4.1 0 0 1 7-2.9 4.1 4.1 0 0 1 7 2.9c0 5.4-7 9.8-7 9.8Z" />
      <path d="M12 13.5v6.7M12 15.5c-1.5-1.1-2.8-1.4-3.8-1.2M12 14.2c1.4-1 2.6-1.3 3.6-1.1" />
    </>
  )}
  {name === 'leaf' && (
    <>
      <path d="M18.5 5.5C12.5 5.5 7 9.5 6.5 17.5 14.5 17 18.5 11.5 18.5 5.5Z" />
      <path d="M4.5 19.5 14.5 9.5" />
    </>
  )}
  {name === 'ribbon' && (
    <>
      <rect x="4.5" y="9.5" width="15" height="10.5" rx="1" />
      <path d="M12 9.5v10.5M4.5 13.5h15" />
      <path d="M12 9.5C9.2 9.5 7.5 8 7.5 6.4c0-1.3 1.1-2.2 2.4-1.9 1.1.3 1.8 1.9 2.1 5Z" />
      <path d="M12 9.5c2.8 0 4.5-1.5 4.5-3.1 0-1.3-1.1-2.2-2.4-1.9-1.1.3-1.8 1.9-2.1 5Z" />
    </>
  )}
  {name === 'note' && (
    <>
      <rect x="3.5" y="5.5" width="17" height="13" rx="1.2" />
      <path d="M12 15.2s-3.2-2-3.2-4.3a1.85 1.85 0 0 1 3.2-1.25 1.85 1.85 0 0 1 3.2 1.25c0 2.3-3.2 4.3-3.2 4.3Z" />
    </>
  )}
</svg>
